#!/bin/bash
# EC2 first-boot bootstrap for the intern omnigent coordinator.
# Rendered by Terraform's templatefile(): the percent-brace tokens below are
# substituted at apply time. This script intentionally uses no shell variable
# expansion, so every brace token is a Terraform value, not a bash one.
set -euxo pipefail
exec > >(tee /var/log/omnigent-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2 git
systemctl enable --now docker

# Clone (or refresh) the repo and check out the intern branch.
install -d -o root -g root /opt
cd /opt
if [ ! -d omnigent/.git ]; then
  git clone "${repo_url}" omnigent
fi
cd omnigent
git fetch --all --prune
git checkout "${branch}"
git pull --ff-only origin "${branch}" || true

# Write the runtime env consumed by deploy/intern-ec2/docker-compose.yaml.
# Secrets land in a 0600 file owned by root.
cd deploy/intern-ec2
umask 077
cat > .env <<ENVEOF
DATABASE_URL=${database_url}
OMNIGENT_ACCOUNTS_COOKIE_SECRET=${cookie_secret}
OMNIGENT_ACCOUNTS_BASE_URL=${base_url}
ENVEOF

# Build from the branch and start. The ALB target stays unhealthy until the
# build finishes and /health responds — expected on first boot.
docker compose up -d --build
